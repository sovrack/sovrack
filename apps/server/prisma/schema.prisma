generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DEVELOPER
}

enum ProjectMemberRole {
  OWNER
  MEMBER
}

enum PipelineStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  CANCELED
}

enum EnvName {
  STAGING
  PRODUCTION
}

enum DeploymentStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  CANCELED
}

enum GitlabSourceType {
  REPO
  GROUP
}

enum ServerConnectionMode {
  SSH
  BASTION
  AGENT
}

enum ServerJobType {
  VERIFY
  INSTALL_TOOLS
  REGISTER_RUNNER
}

enum ServerJobStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  TIMEOUT
  BLOCKED
  AGENT_PENDING
}

model User {
  id          String       @id @default(uuid())
  email       String       @unique
  password    String
  fullName    String
  role        Role         @default(DEVELOPER)
  isActive    Boolean      @default(true)
  projects    ProjectMember[]
  teams       TeamMember[]
  deployments Deployment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Project {
  id            String          @id @default(uuid())
  name          String
  description   String?
  gitlabUrl     String
  gitlabId      Int?
  branch        String          @default("main")
  dockerfile    String          @default("Dockerfile")
  port          Int             @default(3000)
  members       ProjectMember[]
  gitlabConfig  GitlabConfig?
  pipelines     Pipeline[]
  environments  Environment[]
  deployments   Deployment[]
  configs       Config[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model ProjectMember {
  id        String            @id @default(uuid())
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  role      ProjectMemberRole @default(MEMBER)
  joinedAt  DateTime          @default(now())

  @@unique([projectId, userId])
}

model GitlabConfig {
  id                  String   @id @default(uuid())
  gitlabUrl           String
  gitlabToken         String
  gitlabId            Int?
  defaultBranch       String   @default("main")
  sourceType          GitlabSourceType @default(REPO)
  gitlabGroupId       Int?
  deployTokenUsername String?
  deployTokenValue    String?
  webhookSecret       String?
  registryUrl         String?
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId           String   @unique
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Pipeline {
  id        String         @id @default(uuid())
  gitlabId  Int
  status    PipelineStatus
  ref       String
  sha       String
  webUrl    String
  project   Project        @relation(fields: [projectId], references: [id])
  projectId String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([projectId, gitlabId])
}

model Server {
  id                 String               @id @default(uuid())
  name               String
  host               String
  port               Int                  @default(22)
  username           String               @default("ubuntu")
  sshKey             String
  sshPublicKey       String?              @db.Text
  connectionMode     ServerConnectionMode @default(SSH)
  bastionHost        String?
  bastionPort        Int?
  bastionUsername    String?
  bastionSshKey      String?
  agentTokenHash     String?
  agentLastSeenAt    DateTime?
  isActive           Boolean              @default(true)
  isVerified         Boolean              @default(false)
  hasDocker          Boolean              @default(false)
  hasAnsible         Boolean              @default(false)
  hasRunner          Boolean              @default(false)
  environments Environment[]
  jobs               ServerJob[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

model ServerJob {
  id          String          @id @default(uuid())
  server      Server          @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId    String
  type        ServerJobType
  status      ServerJobStatus @default(PENDING)
  payload     Json?
  output      String?
  error       String?
  attempts    Int             @default(0)
  maxAttempts Int             @default(3)
  timeoutMs   Int             @default(45000)
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([serverId, status])
  @@index([createdAt])
}

model Environment {
  id          String       @id @default(uuid())
  name        EnvName
  domain      String?
  isActive    Boolean      @default(true)
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  server      Server       @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId    String
  deployments Deployment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([projectId, name])
}

model Config {
  id        String   @id @default(uuid())
  key       String
  value     String
  isSecret  Boolean  @default(false)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, key])
}

model Deployment {
  id            String           @id @default(uuid())
  status        DeploymentStatus @default(PENDING)
  logs          String?
  dockerImage   String?
  branch        String
  environment   Environment      @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  environmentId String
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId     String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model Team {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  members     TeamMember[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model TeamMember {
  id       String   @id @default(uuid())
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  joinedAt DateTime @default(now())

  @@unique([teamId, userId])
}

model PlatformConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  isSecret  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
