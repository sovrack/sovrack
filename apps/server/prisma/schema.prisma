generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DEVELOPER
}

enum ProjectRole {
  OWNER
  DEVELOPER
  VIEWER
}

enum DeploymentStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  CANCELED
}

enum ServerConnectionMode {
  SSH
}

enum ServerJobType {
  VERIFY
  INSTALL_TOOLS
  PREPARE_SERVER
  REGISTER_RUNNER
}

enum ServerJobStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  TIMEOUT
  BLOCKED
}

enum ServerStatus {
  NEW
  SSH_PENDING
  SSH_VALIDATED
  VALIDATION_FAILED
  INFO_DETECTED
  PREPARATION_PENDING
  PREPARING
  PREPARED
  PARTIALLY_PREPARED
  PREPARATION_FAILED
  UNREACHABLE
  DISABLED
}

// Step in the server onboarding wizard (Server.onboardingStep). Distinct from
// ServerStatus (the lifecycle state): onboardingStep tracks "where the user is"
// in setup. Only PENDING is branched on in logic; the rest are informational.
enum ServerOnboardingStep {
  PENDING
  KEY_INSTALLED
  SSH_VALIDATED
  INFO_DETECTED
  PREPARATION_PENDING
  PREPARING
  READY
  PREPARATION_FAILED
}

enum ServerLogLevel {
  INFO
  WARNING
  ERROR
}

// ServerPreparationStatus / ServerPreparationTaskStatus removed — preparation
// runs now use the unified ServerRunStatus / ServerRunStepStatus enums.

enum ServerInstalledToolStatus {
  INSTALLED
  MISSING
  FAILED
  UNKNOWN
}

enum ServerPreparationProfile {
  BASIC
  WEB
  DATABASE
  RUNNER
  FULL
  CUSTOM
}

enum GitProviderType {
  GITLAB
  GITHUB
  GITEA
}

enum RegistryProviderType {
  DOCKER_HUB
  DOCKER_REGISTRY
  ECR
  GCR
  GITLAB
}

enum BuildStatus {
  NOT_BUILT
  BUILDING
  SUCCESS
  FAILED
  // Aucun build n'était nécessaire (service à image externe / base de
  // données managée / statique) — fait explicite et requêtable, distinct
  // d'un build simplement absent ("pas encore tenté").
  SKIPPED
}

enum DeploymentStrategy {
  STANDARD
  BLUE_GREEN
}

enum BuildPack {
  NIXPACKS
  BUILDPACK
  DOCKERFILE
  DOCKER_COMPOSE
  STATIC
  NONE
}

// How a deployment of a service is triggered (Service.deployTrigger).
enum DeployTrigger {
  PUSH // deploy on every push (Coolify-style)
  PIPELINE_SUCCESS // deploy when the CI pipeline goes green
  CI_HOOK // the CI calls a deploy-hook
  MANUAL // deploy only on explicit request
}

// Where the image is produced (Service.buildMode).
enum BuildMode {
  LOCAL // built on the VPS
  REGISTRY // built by CI, pulled from a registry
}

enum BuildTrigger {
  MANUAL
  WEBHOOK
  API
  RETRY
  ROLLBACK
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
  DEAD_LETTER
}

enum DnsProviderType {
  CLOUDFLARE
  DIGITALOCEAN
  OVH
  MANUAL
}

enum DnsRecordType {
  A
  CNAME
  TXT
}

enum ServerInfraRole {
  STAGING
  PRODUCTION
}

enum ContainerStatus {
  CREATED
  RUNNING
  PAUSED
  RESTARTING
  REMOVING
  EXITED
  DEAD
}

enum ManagedServiceType {
  POSTGRES
  MYSQL
  REDIS
  MONGODB
  RABBITMQ
}

enum ProxyCertType {
  LETS_ENCRYPT
  CUSTOM
  SELF_SIGNED
  NONE
}

// Circuit breaker state for a DockerConnection (anti-notification-storm).
enum CircuitState {
  CLOSED // normal
  OPEN // failing, alerts suppressed until cooldown
  HALF_OPEN // probing once to decide whether to close again
}

model User {
  id                          String              @id @default(uuid())
  email                       String              @unique
  password                    String
  fullName                    String
  role                        Role                @default(DEVELOPER)
  isActive                    Boolean             @default(true)
  projects                    ProjectMember[]
  teams                       TeamMember[]
  deployments                 Deployment[]
  builds                      Build[]
  auditLogs                   AuditLog[]
  sshKeys                     SshKey[]
  serverRunsRequested         ServerRun[]         @relation("ServerRunRequestedBy")
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt
}

model Project {
  id               String            @id @default(uuid())
  name             String
  description      String?
  // Multi-tenant fair-share: cap simultaneous in-flight deployments for this
  // project so one tenant can't monopolize the deploy workers. Null = unlimited.
  maxConcurrentDeploys Int?
  members          ProjectMember[]
  environments     Environment[]
  services         Service[]
  webhookEndpoints WebhookEndpoint[]
  domains          Domain[]
  providerRepos    GitProviderRepo[]
  deployments      Deployment[]
  builds           Build[]
  pipelineRuns     PipelineRun[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectMember {
  id        String      @id @default(uuid())
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  role      ProjectRole @default(DEVELOPER)
  joinedAt  DateTime    @default(now())
  updatedAt DateTime    @default(now()) @updatedAt

  @@unique([projectId, userId])
  @@index([userId, projectId])
}

model Server {
  id                String                   @id @default(uuid())
  name              String
  host              String
  port              Int                      @default(22)
  username          String                   @default("ubuntu")
  sshKey            String
  sshPublicKey      String?                  @db.Text
  connectionMode    ServerConnectionMode     @default(SSH)
  isActive          Boolean                  @default(true)
  isVerified        Boolean                  @default(false)
  status            ServerStatus             @default(NEW)
  verificationError String?                  @db.Text
  infraRole         ServerInfraRole?
  lastVerifiedAt    DateTime?
  lastDetectedAt    DateTime?
  lastPreparedAt    DateTime?
  onboardingStep    ServerOnboardingStep     @default(PENDING)
  // hasDocker/hasRunner removed — derived from `capabilities` via
  // serverHasDocker/serverHasRunner (server-capabilities.util). Single source
  // of truth = the capabilities JSON written by detection.
  jobs              ServerJob[]
  logs              ServerLog[]
  validationResults ServerValidationResult[]
  // Detected capabilities as a flat JSON map { "os.name": "Ubuntu", "docker": "true", ... }
  // and installed tools as a JSON array [{ toolKey, displayName, version, status, ... }].
  // Replaces the former ServerCapability / ServerInstalledTool join tables — a single
  // source of truth, no joins, no 3-way drift on "does this server have Docker".
  capabilities      Json?                    @default("{}")
  installedTools    Json?                    @default("[]")
  serverRuns        ServerRun[]             @relation("ServerRuns")
  serverRunSteps    ServerRunStep[]         @relation("ServerRunSteps")
  dockerConnection  DockerConnection?
  containers       Container[]
  volumes          Volume[]
  proxyRules        ProxyRule[]
  serviceEnvironments ServiceEnvironment[]
  environmentId     String?
  environment       Environment?             @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  // Soft-delete: NULL = active. Set instead of DELETE so server logs,
  // preparations and audit history survive.
  archivedAt        DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@index([environmentId])
}

model ServerJob {
  id          String          @id @default(uuid())
  server      Server          @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId    String
  type        ServerJobType
  status      ServerJobStatus @default(PENDING)
  payload     Json?
  output      String?
  error       String?
  attempts    Int             @default(0)
  maxAttempts Int             @default(3)
  timeoutMs   Int             @default(45000)
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([serverId, status])
  @@index([createdAt])
}

model ServerLog {
  id        String         @id @default(uuid())
  server    Server         @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId  String
  message   String         @db.Text
  level     ServerLogLevel @default(INFO)
  context   String? // "SSH", "VERIFY", "DOCKER", etc.
  createdAt DateTime       @default(now())

  @@index([serverId, createdAt])
  @@index([level])
}

model ServerValidationResult {
  id                String    @id @default(uuid())
  server            Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId          String
  sshReachable      Boolean   @default(false)
  authSucceeded     Boolean   @default(false)
  sudoAvailable     Boolean   @default(false)
  fingerprint       String?
  osName            String?
  osVersion         String?
  architecture      String?
  pythonAvailable   Boolean   @default(false)
  validationMessage String?   @db.Text
  validatedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([serverId, createdAt])
  @@index([serverId, validatedAt])
}

// ServerCapability and ServerInstalledTool models removed — their data now lives
// in Server.capabilities (JSON map) and Server.installedTools (JSON array).
// See servers-detection.service.ts for the read/write shape.

// ServerPreparation / ServerPreparationTask / ServerPreparationLog removed —
// preparation runs are now persisted in the unified ServerRun / ServerRunStep /
// ServerRunLog tables (kind=PREPARATION). See ServerPreparationService.

// ServerAuditEvent model removed — server audit events now live in AuditLog with
// resourceType='SERVER', resourceId=serverId, action=eventType, metadata=payloadJson.
// Read back via ServersAuditService.list().

model Environment {
  id           String               @id @default(uuid())
  name         String
  // When true, only ADMIN platform role or project OWNER can deploy here.
  // A project DEVELOPER receives ForbiddenException on deploy attempts.
  isProtected  Boolean              @default(false)
  env          String?              @db.Text // JSON — variables NON-secrètes de l'environnement
  secretsEnv   String?              @db.Text // JSON — secrets de l'environnement (chiffré au repos)
  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId    String
  deployments  Deployment[]
  servers      Server[]
  serviceLinks ServiceEnvironment[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  // Soft-delete: archive instead of DELETE so the deployment history that
  // references this environment (Deployment.environment is onDelete: Cascade,
  // required) is preserved. Archived rows are filtered out of the API.
  archivedAt   DateTime?

  @@unique([projectId, name])
}

model ServiceEnvironment {
  id            String      @id @default(uuid())
  serviceId     String
  service       Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  environmentId String
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  // Cible de déploiement EXPLICITE (découplage serveur↔environnement). Si défini,
  // ce service-env déploie sur CE serveur ; sinon fallback sur le 1er serveur de
  // l'environnement (comportement historique). Permet à un même VPS d'héberger
  // plusieurs environnements/projets (modèle Coolify/Dokploy).
  serverId      String?
  server        Server?     @relation(fields: [serverId], references: [id], onDelete: SetNull)

  // Overrides — all optional (null = use default from Service)
  branch          String?
  port            Int?
  startCommand    String?
  replicas        Int?
  healthcheckPath String?
  buildPack       BuildPack?

  // Desired-state revision : incrémentée à chaque changement de config (Service
  // ou cet override). Deployment.observedGeneration gèle la valeur déployée →
  // base de la réconciliation désiré↔observé.
  generation      Int        @default(1)

  // Auto-deploy: when true, a git push on `autoBranch` automatically triggers
  // a deployment for this service in this environment. The branch supports
  // exact match only (e.g. "main", "release/v2"). Set autoBranch to null to
  // match any branch.
  autoDeploy      Boolean    @default(false)
  autoBranch      String?    @default("main")

  // Ephemeral preview environments (one per merge/pull request). When isPreview
  // is true this ServiceEnvironment is disposable and tied to previewMrId.
  isPreview       Boolean    @default(false)
  previewMrId     String?
  previewBranch   String?
  env             String?     @db.Text // JSON — variables NON-secrètes (merge final: this > Environment.env > Service.env)
  secretsEnv      String?     @db.Text // JSON — secrets (chiffré au repos ; même ordre de fusion)

  // Soft-delete : "retirer" un service d'un environnement pose archivedAt au
  // lieu de DELETE, ce qui préserve l'historique (Deployment/Build) qui pointe
  // encore vers cette ligne. Réactiver = repasser archivedAt à null (même
  // ligne réutilisée pour respecter @@unique([serviceId, environmentId])).
  archivedAt      DateTime?

  deployments      Deployment[] @relation("ServiceEnvDeployments")
  containers       Container[]
  volumes          Volume[]
  proxyRules       ProxyRule[]
  domains          Domain[]
  builds           Build[]
  webhookEndpoints WebhookEndpoint[]
  dnsRecords       DnsRecord[]
  pipelineRuns     PipelineRun[]
  // Pointeur "release courante" : LE déploiement qui sert RÉELLEMENT cette cellule
  // (état désiré = ce qui doit tourner). Met fin à l'heuristique "dernier SUCCESS
  // deviné par date" (fausse après un rollback). Rollback = on DÉPLACE ce pointeur.
  // Lu par le reconciler et l'UI (matrice) comme source unique du "live".
  currentDeploymentId String?
  currentDeployment   Deployment? @relation("CurrentDeployment", fields: [currentDeploymentId], references: [id], onDelete: SetNull)

  createdAt        DateTime    @default(now())
  // @default(now()) (in addition to @updatedAt) so the column has a DB default —
  // required for `prisma db push` to add it to a non-empty table (e2e harness).
  updatedAt        DateTime    @default(now()) @updatedAt

  @@unique([serviceId, environmentId])
  @@index([environmentId])
  @@index([serverId])
  @@index([currentDeploymentId])
}


model Deployment {
  id                 String             @id @default(uuid())
  status             DeploymentStatus   @default(PENDING)
  strategy           DeploymentStrategy @default(STANDARD)
  logs               String?
  dockerImage        String?
  // Image digest (sha256:...). Preferred over dockerImage for rollback
  // because it's immutable: the same digest is guaranteed to refer to the
  // exact same image content even if the mutable tag was overwritten.
  imageSha           String?
  // Immutable Release model: the FROZEN desired state captured at deploy time
  // (source ref, build strategy/config, strategy). Enables exact rollback,
  // audit and diff — the deployment is an immutable revision, not mutated.
  specSnapshot       Json?
  // The CONCRETE refs this deployment resolved to (server, environment, …) —
  // the orchestrator output. Separates "what was desired" (specSnapshot) from
  // "what it was bound to" (resolvedRefs).
  resolvedRefs       Json?
  // Reconciliation status (K8s-style): structured conditions (Ready /
  // Progressing / Degraded with reason+message) and the generation of the
  // spec this status reflects — the basis for a desired-state reconciler.
  conditions         Json?
  observedGeneration Int?
  // Reference to a Build record (see model Build). Nullable for legacy
  // rows pre-dating the Build table; new code paths must always set it.
  buildId            String?
  build              Build?             @relation("BuildToDeployment", fields: [buildId], references: [id], onDelete: SetNull)
  externalPipelineId BigInt?
  isRollback         Boolean            @default(false)
  rolledBackAt       DateTime?
  // Self-healing: set when the reconciler recreated a crashed container.
  isAutoHealed       Boolean            @default(false)
  autoHealReason     String?
  branch             String
  serviceId          String?
  service            Service?           @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  // Nullable is INTENTIONAL: set to null via onDelete:SetNull when the parent
  // ServiceEnvironment is archived (soft-delete), so deployment history survives
  // for audit/rollback without a dangling FK. All live deploy paths (create,
  // rollback, auto-heal) always set it; the executor fails fast on a null cell
  // (a deploy without a cell can't move currentDeploymentId or be reconciled).
  serviceEnvId       String?
  serviceEnv         ServiceEnvironment? @relation("ServiceEnvDeployments", fields: [serviceEnvId], references: [id], onDelete: SetNull)
  // Back-relation du pointeur "release courante" (ServiceEnvironment.currentDeployment).
  currentForServiceEnvs ServiceEnvironment[] @relation("CurrentDeployment")
  environment        Environment        @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  environmentId      String
  project            Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId          String
  user               User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId             String?
  startedAt          DateTime?
  finishedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  previousDeploymentId String?
  previousDeployment   Deployment?   @relation("DeploymentHistory", fields: [previousDeploymentId], references: [id], onDelete: SetNull)
  nextDeployments      Deployment[]  @relation("DeploymentHistory")
  pipelineRuns         PipelineRun[]
  containers           Container[]

  @@index([externalPipelineId])
  @@index([projectId, environmentId, externalPipelineId])
  @@index([serviceId])
  // [serviceEnvId] alone is covered by the [serviceEnvId, status, createdAt]
  // composite (prefix) below — keeping only the composite avoids a redundant index.
  @@index([buildId])
  @@index([status, updatedAt])
  @@index([environmentId, status])
  @@index([serviceEnvId, status, createdAt])
  @@index([userId])
  @@index([previousDeploymentId])
}

// ============================================================================
// Build — central table for build lifecycle (P2-#1 of the refactoring plan).
// ============================================================================
//
// A Build represents one attempt to produce a deployable artifact (a Docker
// image, a static release directory, …) from a git commit. It is decoupled
// from Deployment: one Build can be deployed multiple times (re-deploys of
// the same image, rollbacks, blue-green swaps), and one Deployment always
// references exactly one Build.
//
// Rollout DONE: the duplicate build columns that used to live on Deployment
// (buildStrategy/buildMode/nixpacksConfig/staticConfig/buildLog) have already
// been dropped — Build is now the single source of truth for build state.
// `Deployment.buildId` references the Build (nullable only for legacy rows).
//
// Build carries the build state (was duplicated on Deployment):
//   - buildStatus / buildLog  →  Build.status / Build.logs
//   - nixpacksConfig/staticConfig →  Build.nixpacksConfig / Build.staticConfig
//   - gitlabPipelineId → Build.gitlabPipelineId
//   - dockerImage + imageSha → Build.imageRepository + imageTag + imageSha
model Build {
  id                 String       @id @default(uuid())
  projectId          String
  project            Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  serviceId          String?
  service            Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceEnvId       String?
  serviceEnv         ServiceEnvironment? @relation(fields: [serviceEnvId], references: [id], onDelete: SetNull)
  branch             String
  commitSha          String?
  buildPack          BuildPack
  // True when the build (and deploy) happens directly on the target VPS.
  // False when a pre-built image is pulled from a registry (GitLab CI flow).
  // Replaces the legacy Deployment.buildMode (LOCAL/REGISTRY) distinction.
  isLocalBuild       Boolean      @default(false)
  status             BuildStatus  @default(NOT_BUILT)
  triggeredBy        BuildTrigger @default(MANUAL)
  // Image digest (sha256:...) — immutable, used for rollback pinning.
  imageSha           String?
  // Release directory for STATIC builds (ex: /var/www/slug/releases/ts-sha8/).
  releaseDir         String?
  // Registry where the image was pushed (nullable for STATIC).
  registryUrl        String?
  imageRepository    String?
  imageTag           String?
  // Full build log (was Deployment.buildLog).
  logs               String?      @db.Text
  startedAt          DateTime?
  finishedAt         DateTime?
  // CI/CD pipeline ID (GitLab pipeline ID or GitHub Actions run ID).
  externalPipelineId BigInt?
  // Build-pack-specific config (single source of truth — no longer on Deployment).
  nixpacksConfig     Json?
  staticConfig       Json?
  // Error message when status=FAILED.
  errorMessage       String?      @db.Text
  userId             String?
  user               User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  deployments Deployment[] @relation("BuildToDeployment")

  @@index([projectId, status])
  @@index([projectId, branch, createdAt])
  @@index([commitSha])
  @@index([imageSha])
  @@index([status, createdAt])
  @@index([serviceId])
  @@index([serviceEnvId])
  @@index([userId])
}

// ============================================================================
// Container — tracks a live Docker container on a server.
// Created by the platform when a deployment runs; synced from Docker Engine API.
// ============================================================================
model Container {
  id           String          @id @default(uuid())
  dockerId     String
  name         String
  imageRef     String
  status       ContainerStatus @default(CREATED)
  deploymentId String?
  deployment   Deployment?     @relation(fields: [deploymentId], references: [id], onDelete: SetNull)
  serverId     String
  server       Server          @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serviceId     String?
  service       Service?        @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceEnvId  String?
  serviceEnv    ServiceEnvironment? @relation(fields: [serviceEnvId], references: [id], onDelete: SetNull)
  lastSeenAt    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([serverId, status])
  @@index([deploymentId])
  @@index([dockerId])
  @@index([serviceId])
  @@index([serviceEnvId])
  @@index([serverId, deploymentId])
}

// ============================================================================
// Volume — a persistent Docker volume on a server.
// Attached to a service or a managed service.
// ============================================================================
model Volume {
  id        String   @id @default(uuid())
  name      String
  mountPath String?
  sizeGb    Int?
  serverId  String
  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serviceId     String?
  service       Service?                       @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceEnvId  String?
  serviceEnv    ServiceEnvironment?             @relation(fields: [serviceEnvId], references: [id], onDelete: SetNull)
  createdAt     DateTime                        @default(now())
  updatedAt     DateTime                        @updatedAt

  @@index([serverId])
  @@index([serviceId])
  @@index([serviceEnvId])
}

// ============================================================================
// ProxyRule — a reverse-proxy rule (Traefik / Caddy) mapping a domain to a port.
// SSL is managed by the proxy module (Let's Encrypt by default).
// ============================================================================
model ProxyRule {
  id            String        @id @default(uuid())
  // Hostname (kept denormalized for Traefik config generation + the existing
  // [serverId, domain] uniqueness). Prefer domainRef as the source of truth.
  domain        String
  // FK to the Domain row for this hostname (nullable: legacy rules + rules made
  // before a Domain exists). onDelete:Cascade so deleting a Domain removes its
  // proxy rule instead of leaving an orphan. @unique → one ProxyRule per Domain.
  domainId      String?       @unique
  domainRef     Domain?       @relation("ProxyRuleDomain", fields: [domainId], references: [id], onDelete: Cascade)
  targetPort    Int
  sslEnabled    Boolean       @default(true)
  certType      ProxyCertType @default(LETS_ENCRYPT)
  isActive      Boolean       @default(true)
  serverId      String
  server        Server        @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serviceEnvId  String?
  serviceEnv    ServiceEnvironment? @relation(fields: [serviceEnvId], references: [id], onDelete: SetNull)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([serverId, domain])
  @@index([serverId])
  @@index([serviceEnvId])
}


model Team {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  members     TeamMember[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model TeamMember {
  id       String   @id @default(uuid())
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  joinedAt DateTime @default(now())

  @@unique([teamId, userId])
}

model AuditLog {
  id           String   @id @default(uuid())
  // Nullable since the unified audit log now also stores SERVER events that may
  // be actorless (system / automation). User-attributed rows keep a userId.
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action       String
  resourceType String
  resourceId   String
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([resourceType, resourceId])
}

model SshKey {
  id                  String   @id @default(uuid())
  name                String
  encryptedPrivateKey String   @db.Text
  publicKey           String   @db.Text
  keyType             String   @default("ed25519")
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId])
}

model PlatformConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  isSecret  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GitProviderConfig {
  id                  String            @id @default(uuid())
  name                String
  type                GitProviderType   @default(GITLAB)
  providerUrl         String
  internalUrl         String?
  redirectUri         String?
  applicationId       String?
  applicationSecret   String?           @db.Text
  groupNames          String?
  adminToken          String?           @db.Text
  oauthAccessToken    String?           @db.Text
  oauthRefreshToken   String?           @db.Text
  oauthExpiresAt      DateTime?
  oauthState          String?
  oauthStateExpiresAt DateTime?
  isDefault           Boolean           @default(false)
  providerRepos       GitProviderRepo[]
  services            Service[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([type, name])
  @@index([type, isDefault])
}

model GitProviderRepo {
  id            String            @id @default(uuid())
  provider      GitProviderConfig @relation(fields: [providerId], references: [id], onDelete: Cascade)
  providerId    String
  repoPath      String            // "group/project" ou "owner/repo"
  defaultBranch String            @default("main")
  // Per-repo webhook secret (encrypted with CONFIG_SECRET). Used for HMAC verification.
  webhookSecret String?           @db.Text
  // ID of the webhook created on the Git provider side (for update/delete).
  webhookId     String?
  // Optional link to a platform project.
  projectId     String?
  project       Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  // Optional link to a specific Service (for webhook routing to the right service).
  serviceId     String?
  service       Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([providerId, repoPath])
  @@index([projectId])
  @@index([serviceId])
}

model RegistryConfig {
  id              String               @id @default(uuid())
  name            String
  type            RegistryProviderType
  username        String?
  password        String?              @db.Text
  registryUrl     String?
  isDefault       Boolean              @default(false)
  isConnected     Boolean              @default(false)
  connectionError String?
  // Registre auto-provisionné depuis un provider Git (GitLab) : lien vers la
  // config provider d'origine → resync (URL/creds) + dédoublonnage par provider.
  providerId      String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([type, name])
  @@index([type, isDefault])
  @@index([providerId])
}


model DnsProvider {
  id        String          @id @default(uuid())
  name      String
  type      DnsProviderType @default(MANUAL)
  apiToken  String?         @db.Text
  accountId String?
  zoneId    String?
  domains   Domain[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([type, name])
}

model Domain {
  id         String       @id @default(uuid())
  name       String
  providerId String?
  provider   DnsProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  projectId  String?
  project    Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  serviceEnvId String?
  serviceEnv   ServiceEnvironment? @relation(fields: [serviceEnvId], references: [id], onDelete: SetNull)
  verified     Boolean             @default(false)
  records      DnsRecord[]
  sslCertificate SslCertificate?
  // Reverse-proxy rule for this hostname (1:1). Cascade-deletes with the Domain.
  proxyRule      ProxyRule?          @relation("ProxyRuleDomain")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([projectId, name])
  @@index([providerId])
  @@index([projectId])
  @@index([serviceEnvId])
}

// ============================================================================
// SslCertificate — métadonnées d'un certificat TLS Let's Encrypt émis pour un
// Domain. Auparavant manipulée en SQL brut sur une table INEXISTANTE (le cron
// de renouvellement crashait : relation "SslCertificate" does not exist).
// Modélisée ici pour des accès Prisma typés.
// ============================================================================
model SslCertificate {
  id              String   @id @default(uuid())
  domainId        String   @unique
  domain          Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)
  // Dénormalisé depuis Domain.name : le cron de renouvellement filtre dessus
  // sans jointure, et c'est la clé d'upsert (un certificat par nom d'hôte).
  domainName      String   @unique
  certificatePath String
  keyPath         String
  expiresAt       DateTime
  autoRenewal     Boolean  @default(true)
  lastRenewalAttemptAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Sert la requête getExpiringCertificates (expiresAt < seuil AND autoRenewal).
  @@index([autoRenewal, expiresAt])
}

model DnsRecord {
  id            String        @id @default(uuid())
  domainId      String
  domain        Domain        @relation(fields: [domainId], references: [id], onDelete: Cascade)
  type          DnsRecordType
  name          String
  value         String
  ttl           Int           @default(300)
  proxied       Boolean?
  serviceEnvId String?
  serviceEnv   ServiceEnvironment? @relation(fields: [serviceEnvId], references: [id], onDelete: SetNull)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([domainId, type, name])
  @@index([serviceEnvId])
}

// ============================================================
// AUTOMATION MODULE
// ------------------------------------------------------------
// AutomationRun(+Target+Log) supprimés (P7) : entièrement remplacés par
// ServerOperation(+Target+Log) — voir automation.service / automation-runner.
// L'automation est une opération multi-cibles : c'est exactement ce que
// ServerOperation modélise, donc aucune table dédiée n'est nécessaire.
// ============================================================

// ============================================================================
// Webhook observability (P4 of the refactoring plan).
// ============================================================================
//
// `WebhookEndpoint` is the per-(project, service) handle that the platform
// exposes to a Git provider to receive push / pull_request / pipeline events.
// One endpoint per (project + service) pair. The `webhookToken` is the
// UUID v4 used in the public URL — it is the routing key.
//
// `WebhookEvent` is the audit log of every webhook received. It is the
// safety net for debugging ("why didn't my push trigger a deploy?") and
// the basis for the future retry / dead-letter mechanism.
//
// Phase 1 (this migration, non-breaking): introduce the tables and the
// observability service. Existing webhook handlers (gitlab-webhook,
// github-webhook) keep their current shape — they just call
// `webhooksService.record(...)` to log every event.
//
// Phase 2 (breaking): unify under a single `POST /webhooks/:endpointId`
// endpoint and dispatch by token. Drop the per-provider webhook URLs.
model WebhookEndpoint {
  id           String          @id @default(uuid())
  projectId    String
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  serviceEnvId String?
  serviceEnv   ServiceEnvironment? @relation(fields: [serviceEnvId], references: [id], onDelete: SetNull)
  // Webhook PAR SERVICE (1 service = 1 repo = 1 webhook). La branche du push
  // route ensuite vers le bon environnement (ServiceEnvironment.autoBranch).
  serviceId    String?
  service      Service?            @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  webhookToken String              @unique @default(uuid())
  // Secret partagé avec le provider, CHIFFRÉ (CONFIG_SECRET). Sert à vérifier
  // l'authenticité des webhooks entrants : GitLab compare X-Gitlab-Token ;
  // GitHub vérifie le HMAC X-Hub-Signature-256. Nullable = endpoints legacy
  // (créés avant le stockage du secret) → vérification ignorée (rétro-compat).
  secret       String?
  // Provider type (GitLab / GitHub / future). Stored so we know which
  // signature scheme to use for `verifyWebhookToken` at routing time.
  provider     GitProviderType
  isActive     Boolean         @default(true)
  // Subset of events we want to receive (push, pull_request, etc.).
  // The platform still receives everything but ignores events not in
  // this list (returns 200 OK with status=IGNORED).
  events       String[]
  // Last time we received a webhook for this endpoint. Useful for the
  // admin UI to detect "endpoint configured but no events for 30 days".
  lastEventAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  webhookEvents WebhookEvent[]

  @@index([projectId])
  @@index([serviceEnvId])
  @@index([serviceId])
  @@index([provider, isActive])
}

model WebhookEvent {
  id                 String             @id @default(uuid())
  endpointId         String
  endpoint           WebhookEndpoint    @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  provider           GitProviderType
  eventType          String
  // Provider-side delivery id (e.g. GitLab `delivery_id` header, GitHub
  // `X-GitHub-Delivery` UUID). Used for idempotence — re-deliveries of
  // the same event are deduplicated.
  externalDeliveryId String?
  // Raw payload (signed bytes). We persist it so failed events can be
  // replayed after a code fix.
  payload            Json
  // Relevant request headers (X-Gitlab-Event, X-Hub-Signature-256, …).
  headers            Json
  status             WebhookEventStatus @default(RECEIVED)
  attempts           Int                @default(0)
  lastAttemptAt      DateTime?
  nextRetryAt        DateTime?
  errorMessage       String?            @db.Text
  // Normalized event (set by the processor before it triggers a build
  // or a deploy). Null until processed.
  normalizedEvent    Json?
  receivedAt         DateTime           @default(now())
  processedAt        DateTime?

  @@index([endpointId, receivedAt])
  @@index([status, nextRetryAt])
  @@index([externalDeliveryId])
  @@index([provider, eventType, receivedAt])
}

// ============================================================================
// DockerConnection — direct TCP+TLS connection to a server's Docker daemon
// (P5 of the refactoring plan).
// ============================================================================
//
// Currently, all Docker operations go through SSH (`ServersSshService`)
// and shell commands. That works for deployments but blocks two use cases:
//   1. Real-time build progress / container stats (need streaming API)
//   2. Health monitoring that needs to know which daemon the platform
//      actually talks to
//
// `DockerConnection` carries the TCP endpoint + TLS material (encrypted
// with CONFIG_SECRET) for each server. The `Servers` table stays the
// source of truth for "this is a server we deploy to"; `DockerConnection`
// is the optional companion for "this is how we talk to its daemon".
//
// Phase 1 (this migration, non-breaking): introduce the table and the
// service. Existing SSH-based flows are unchanged. The platform admin
// can configure Docker connections out-of-band (manually or via the
// Ansible `docker` role in a future PR).
model DockerConnection {
  id            String    @id @default(uuid())
  serverId      String    @unique
  server        Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  // ex: "tcp://10.0.0.1:2376" (Docker daemon TLS port, NOT 2375 which
  // is the unencrypted port and must never be used in production).
  endpoint      String
  // TLS material, each blob encrypted with CONFIG_SECRET. Stored as @db.Text
  // because PEM-encoded certs can exceed the default varchar length.
  tlsCaCert     String    @db.Text
  tlsClientCert String    @db.Text
  tlsClientKey  String    @db.Text
  // Docker API version detected at the last successful reachability check.
  // Useful to surface "this server is too old" warnings in the admin UI.
  apiVersion    String?
  // Last time we successfully completed a reachability probe. NULL means
  // "never verified".
  lastCheckedAt DateTime?
  // True if the last probe succeeded. False (with lastCheckedAt set) means
  // the connection is configured but unreachable right now — fire alarm.
  isReachable   Boolean   @default(false)
  // ── Circuit breaker (anti-notification-storm on flapping connections) ──
  // CLOSED: normal. OPEN: failing, alerts suppressed until cooldown elapses.
  // HALF_OPEN: probing once to decide whether to close again.
  consecutiveFailures Int          @default(0)
  circuitState        CircuitState @default(CLOSED)
  circuitOpenedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([isReachable])
}

// ─── PipelineRun ────────────────────────────────────────────────────────────
// Tracks the correlation between a CI pipeline run (GitLab pipeline /
// GitHub Actions workflow run) and the deployment it triggered.
// Replaces the fragile log-based [PIPELINE_ID:xxx] markers with a
// proper relational record.
//
// Lifecycle:
//   PENDING   → pipeline triggered, waiting for webhook
//   RUNNING   → webhook received, pipeline in progress
//   SUCCESS   → pipeline completed, deployment started
//   FAILED    → pipeline failed, deployment marked FAILED
//   CANCELED  → pipeline canceled
//   IGNORED   → webhook received but no matching deployment found
model PipelineRun {
  id           String            @id @default(uuid())
  // The external pipeline ID (GitLab pipeline ID, GitHub run ID, etc.)
  externalId   BigInt
  provider     GitProviderType
  status       PipelineRunStatus @default(PENDING)
  branch       String?
  commitSha    String?
  // URL to the pipeline on the provider (for UI links)
  webUrl       String?
  // Image pushed by the pipeline (registry path + tag)
  imageSha     String?
  // The deployment that was triggered by this pipeline (null until matched)
  deploymentId String?
  deployment   Deployment?       @relation(fields: [deploymentId], references: [id], onDelete: SetNull)
  projectId    String
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  serviceEnvId String?
  serviceEnv   ServiceEnvironment? @relation(fields: [serviceEnvId], references: [id], onDelete: SetNull)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([externalId, provider])
  @@index([deploymentId])
  @@index([projectId, status])
  @@index([externalId])
  @@index([serviceEnvId])
}

enum PipelineRunStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  CANCELED
  IGNORED
}

// ============================================================================
// NEW enums for unified Service model (Phase 1 — refactoring architecturale)
// ============================================================================

// Modele Railway : le TYPE dit seulement la nature du service (5 valeurs).
// Le "comment on construit/deploie" est porte par sourceType (GIT/DOCKER_IMAGE/
// NONE) + buildPack/buildType, axes orthogonaux. On NE duplique donc pas un
// enum "ArtifactSource" : sourceType joue deja ce role.
//   APPLICATION : service applicatif web expose (HTTP)
//   WORKER      : process long-running sans port (consumer de queue, etc.)
//   CRON        : tache planifiee (job recurrent)
//   DATABASE    : base de donnees auto-hebergee (Postgres/MySQL/Redis/Mongo/RabbitMQ)
//   MANAGED     : service externe/manage (image pre-construite, pas de build)
enum ServiceType {
  APPLICATION
  DATABASE
  MANAGED
  WORKER
  CRON
}

enum SourceType {
  GIT
  DOCKER_IMAGE
  NONE
}

// ============================================================================
// Service — NEW central model (replaces ProjectService, AppProviderLink, and ManagedService)

// A Service is the atomic unit of the system. Everything is a Service.

// The type determines validation: APPLICATION → source + build required,
// DATABASE → databaseType requis, COMPOSE → composeContent requis.
// ============================================================================
model Service {
  id          String      @id @default(uuid())
  name        String
  type        ServiceType @default(APPLICATION)
  description String?

  // Project attachment (M3 — service no longer belongs to a single env)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Source (APPLICATION)
  sourceType SourceType? @default(GIT)
  repoPath   String?
  // CONFIG niveau 1 (défaut du service) : branche par défaut, SURCHARGEABLE
  // par ServiceEnvironment.branch (null = hérite de cette valeur). À ne pas
  // confondre avec Build.branch / Deployment.branch qui sont des SNAPSHOTS
  // immuables (la branche réellement construite/déployée à un instant T).
  branch     String?     @default("main")
  provider   GitProviderConfig? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  providerId String?
  rootDir    String?     @default("/")

  // Build (APPLICATION)
  buildPack            BuildPack? @default(DOCKERFILE)
  // Mode de build choisi : LOCAL (build sur le VPS) ou REGISTRY (image construite
  // par la CI puis pull). Combiné à buildPack → buildSource (DOCKERFILE_LOCAL,
  // DOCKERFILE_REGISTRY, NIXPACKS_LOCAL…). Image externe = sourceType DOCKER_IMAGE.
  buildMode            BuildMode? @default(LOCAL)
  // Déclencheur du déploiement. Défaut DB = PIPELINE_SUCCESS (rétro-compat) ;
  // les nouveaux services sont créés en PUSH (cf services.service.create).
  deployTrigger        DeployTrigger? @default(PIPELINE_SUCCESS)
  // Mode REGISTRY : référence d'image (registry/chemin:tag) à tirer telle quelle
  // au déploiement, au lieu de la dériver de la CI. Null = dérivation auto.
  registryImage        String?
  // RESOLVED build type detected/declared for the pipeline (e.g. "dockerized",
  // "nixpacks", "static"). Distinct from buildPack (the user's strategy choice)
  // and buildMode (LOCAL vs REGISTRY): build-detector WRITES it, build-setup
  // READS it (`service.buildType ?? 'dockerized'`). Not user-facing input.
  buildType            String?
  dockerfile           String?    @db.Text
  port                 Int?       @default(3000)
  startCommand         String?
  buildArgs            Json?
  nixpacksConfig       Json?
  staticConfig         Json?
  dockerComposeContent String?    @db.Text
  composeServiceName   String?

  // Database (DATABASE)
  databaseType        ManagedServiceType?
  databaseVersion     String?             @default("latest")
  databaseCredentials Json? // { user, password, dbName }
  // Host port to publish for external access (e.g. connecting from outside
  // the project). Null = not exposed externally — the default, and the only
  // way other services in this project can reach it is the internal Docker
  // network alias (see buildServiceAlias). Set by the user from the
  // DATABASE service's "External Credentials" UI; enforced at deploy time in
  // DockerDeployExecutorService (no host port bound when null).
  externalPort Int?

  // Runtime
  env             String? @db.Text // JSON — variables NON-secrètes du service (affichables)
  secretsEnv      String? @db.Text // JSON — secrets du service (chiffré au repos, jamais affiché en clair)
  healthcheckPath String?
  replicas        Int     @default(1)
  // Resource quotas (multi-tenant safety). cpuLimit = fractional cores
  // (e.g. 0.5), memLimitMb = hard memory cap in MB. Null = unlimited. Applied
  // to the container HostConfig (NanoCpus / Memory) at deploy.
  cpuLimit        Float?
  memLimitMb      Int?
  // Pre-deploy command executed inside the new image before traffic cutover
  // (e.g. "npx prisma migrate deploy"). Exit code ≠ 0 → deployment FAILED.
  preDeployCommand    String?
  preDeployTimeout    Int     @default(120)
  // Seconds Docker waits after SIGTERM before sending SIGKILL.
  shutdownTimeout     Int     @default(30)

  envLinks         ServiceEnvironment[]
  deployments      Deployment[]
  builds           Build[]
  webhookEndpoints WebhookEndpoint[]
  containers       Container[]
  volumes          Volume[]
  gitProviderRepos GitProviderRepo[]

  // Soft-delete: NULL = active. Set instead of DELETE so deployment/build
  // history that references this service survives.
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // NOTE: unicité (projectId, name) appliquée par un INDEX UNIQUE PARTIEL
  // `WHERE "archivedAt" IS NULL` (migration 20260625130000), PAS par @@unique :
  // ainsi un service ARCHIVÉ ne bloque plus la réutilisation de son nom. Prisma
  // ne modélise pas les index partiels mais les IGNORE proprement au diff
  // (vérifié : aucun "drift") → cohabitation sans accroc.
  @@index([projectId])
  @@index([providerId])
}

// ============================================================================
// ServerOperation — registre des opérations serveur MULTI-CIBLES (P7).
// ServerOperation / ServerOperationTarget / ServerOperationLog (and their
// ServerOperationStatus / ServerOperationTargetStatus enums) removed —
// automation runs are now persisted in the unified ServerRun / ServerRunStep /
// ServerRunLog tables (kind=AUTOMATION). See AutomationService.

// ─────────────────────────────────────────────────────────────────────────────
// ServerRun — generic run/step/log hierarchy unifying the two near-identical
// structural families:
//   Family B: ServerPreparation / ServerPreparationTask / ServerPreparationLog
//   Family C: ServerOperation / ServerOperationTarget / ServerOperationLog
//
// PREPARATION runs target a single server and progress per ansible role.
// AUTOMATION  runs target N servers in parallel and progress per server.
//
// Family A (ServerJob / ServerLog / ServerValidationResult) is intentionally
// kept separate: ServerJob is a mutex/retry-lock primitive, ServerLog is a
// flat audit feed, and ServerValidationResult is a snapshot cache — none of
// these have the "run → ordered steps → streaming log" shape that B and C
// share. Collapsing them into ServerRun would add nullable columns for
// unrelated concerns (nullable-everything anti-pattern).
//
// The old B/C models are kept alive during the cutover window and will be
// dropped in a separate confirmed migration once everything is verified.
// ─────────────────────────────────────────────────────────────────────────────

enum ServerRunKind {
  PREPARATION
  AUTOMATION
}

enum ServerRunStatus {
  QUEUED
  RESOLVING_OPTIONS
  WAITING_FOR_LOCK
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
  TIMEOUT
  CANCELED
}

enum ServerRunStepStatus {
  PENDING
  SKIPPED
  RUNNING
  OK
  CHANGED
  SUCCEEDED
  FAILED
  TIMEOUT
  CANCELED
}

model ServerRun {
  id            String          @id @default(uuid())
  kind          ServerRunKind
  // PREPARATION: serverId set, steps keyed by roleKey.
  // AUTOMATION:  serverId null, steps keyed by serverId.
  serverId      String?
  server        Server?         @relation("ServerRuns", fields: [serverId], references: [id], onDelete: Cascade)
  actionKey     String?
  actionLabel   String?
  profile       String?
  status        ServerRunStatus @default(QUEUED)
  triggerSource String          @default("USER")
  requestedById String?
  requestedBy   User?           @relation("ServerRunRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  paramsJson    Json            @default("{}")
  resolvedJson  Json?
  summary       String?         @db.Text
  errorMessage  String?         @db.Text
  attempts      Int             @default(0)
  maxAttempts   Int             @default(1)
  timeoutMs     Int?
  retryOfId     String?
  retryOf       ServerRun?      @relation("ServerRunRetry", fields: [retryOfId], references: [id], onDelete: SetNull)
  retries       ServerRun[]     @relation("ServerRunRetry")
  startedAt     DateTime?
  finishedAt    DateTime?
  steps         ServerRunStep[]
  logs          ServerRunLog[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([serverId, status])
  @@index([status])
  @@index([actionKey])
  @@index([createdAt])
  @@index([requestedById])
  @@index([retryOfId])
}

model ServerRunStep {
  id           String              @id @default(uuid())
  runId        String
  run          ServerRun           @relation(fields: [runId], references: [id], onDelete: Cascade)
  // PREPARATION step: roleKey set, serverId null.
  // AUTOMATION  step: serverId set, roleKey null.
  // Both @@unique constraints use nullable columns; Postgres treats NULL as
  // distinct in unique indexes so the non-applicable side never collides.
  roleKey      String?
  serverId     String?
  server       Server?             @relation("ServerRunSteps", fields: [serverId], references: [id], onDelete: Cascade)
  taskName     String?
  orderIndex   Int                 @default(0)
  status       ServerRunStepStatus @default(PENDING)
  startedAt    DateTime?
  finishedAt   DateTime?
  message      String?             @db.Text
  errorMessage String?             @db.Text
  output       String?             @db.Text
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([runId, roleKey])
  @@unique([runId, serverId])
  @@index([runId, orderIndex])
}

model ServerRunLog {
  id         String         @id @default(uuid())
  runId      String
  run        ServerRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  serverId   String?
  level      ServerLogLevel @default(INFO)
  source     String         @default("orchestrator")
  message    String         @db.Text
  lineNumber Int            @default(0)
  createdAt  DateTime       @default(now())

  @@index([runId, lineNumber])
  @@index([runId, createdAt])
  @@index([level])
  @@index([serverId])
}
