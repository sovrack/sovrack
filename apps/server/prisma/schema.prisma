  // that a customer can own at most one personal workspace.
  personalOwnerId     String?               @unique
  personalOwner       User?                 @relation("PersonalWorkspaceOwner", fields: [personalOwnerId], references: [id], onDelete: Restrict)
  organizationProfile OrganizationProfile?
  members             TeamMember[]
  projectMembers      ProjectMember[]
  projects            Project[]
  servers             Server[]
  sshKeys             SshKey[]
  gitProviderConfigs  GitProviderConfig[]
  registryConfigs     RegistryConfig[]
  dnsProviders        DnsProvider[]
  auditLogs           AuditLog[]
  invitations         WorkspaceInvitation[]
  serverRuns          ServerRun[]
  subscription        Subscription?
  invoices            Invoice[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([type, status])
}

model OrganizationProfile {
  id                 String   @id @default(uuid())
  teamId             String   @unique
  team               Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  legalName          String?
