global:
  scrape_interval: {{ prometheus_scrape_interval }}

scrape_configs:
  - job_name: node_exporter
    static_configs:
      - targets:
          - "{{ prometheus_target_node_exporter }}"

  - job_name: cadvisor
    static_configs:
      - targets:
          - "{{ prometheus_target_cadvisor }}"

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - "{{ prometheus_target_alertmanager }}"
