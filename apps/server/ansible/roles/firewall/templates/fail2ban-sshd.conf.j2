# Fail2Ban SSH Protection Configuration
# Auto-generated by Ansible

[sshd]
enabled = true
port = ssh
filter = sshd
logpath = /var/log/auth.log
backend = systemd

# Ban settings
maxretry = {{ fail2ban_ssh_max_retries }}
findtime = {{ fail2ban_ssh_find_time }}
bantime = {{ fail2ban_ssh_ban_time }}

# Actions
action = %(action_mwl)s

# Custom action (email + UFW)
action_mwl = %(banaction)s[name=%(__name__)s, port=%(port)s, protocol=%(protocol)s, chain=%(chain)s]
             %(action_mw)s[%(logpath)s]

# Whitelist IPs (you can add your office/home IPs here)
ignoreip = 127.0.0.1/8 ::1
