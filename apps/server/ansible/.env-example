# Environment variables for Ansible playbooks

# GitLab Runner Token (required for gitlab-runner role)
# Get this from: https://gitlab.com/admin/runners
GITLAB_RUNNER_TOKEN=glrt_your_token_here

# GitLab URL (optional, defaults to https://gitlab.com/)
GITLAB_URL=https://gitlab.com/

# Runner Registration Tags
GITLAB_RUNNER_TAGS=docker,deployment,linux

# Docker daemon socket (for GitLab Runner)
DOCKER_SOCKET=/var/run/docker.sock
