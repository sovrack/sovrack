# compiled output
/dist
/node_modules
/build

# compiled TS artifacts next to prisma scripts (regenerated from *.ts)
/prisma/*.js
/prisma/*.js.map
/prisma/*.d.ts
# seed-staff est un script JS dédié (source, pas un artefact compilé) : on le versionne.
!/prisma/seed-staff.js
!/prisma/seed-local.js

# Logs
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS
.DS_Store

# Tests
/coverage
/.nyc_output

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# any local-override file (config, compose, etc.)
*.local

# temp directory
.temp
.tmp

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# env example ne pas ignorer
!.env.example
/generated/prisma
.ansible-venv/
.ansible-local/
.keys/

# local SSH known_hosts accumulated by dev machines connecting to test
# servers — leaks internal IPs/hostnames, never useful to commit.
.local/

# TLS client certs fetched locally from a server by enable-docker-tls.yml —
# credential material, never committed (see security fix 2026-07-03).
/ansible/out/

# TypeScript incremental cache (ne jamais committer — peut bloquer l'emit)
*.tsbuildinfo
