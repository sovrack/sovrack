# App
PORT=3001

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=devops_platform

# Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devops_platform

# JWT — générer avec : node -e "require('crypto').randomBytes(48).toString('hex')" | xargs echo "JWT_SECRET="
JWT_SECRET=CHANGE_ME_WITH_A_STRONG_64_CHAR_HEX_SECRET
JWT_EXPIRES_IN=24h
AUTH_COOKIE_NAME=devops_platform_token
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_SECURE=false
# AUTH_COOKIE_DOMAIN=example.com
# AUTH_COOKIE_MAX_AGE_MS=86400000

# GitLab
GITLAB_URL=
GITLAB_TOKEN=

# Deployments
# CONFIG_SECRET — minimum 32 caractères. Changer invalide les données chiffrées existantes.
# Générer avec : node -e "require('crypto').randomBytes(32).toString('hex')" | xargs echo "CONFIG_SECRET="
CONFIG_SECRET=CHANGE_ME_WITH_A_STRONG_32_CHAR_HEX_SECRET
ANSIBLE_PLAYBOOKS_PATH=../devops/ansible/playbooks
ANSIBLE_VENV_PATH=../.local/.ansible-venv
# Optional legacy variable (not required by Server Preparation flow):
# ANSIBLE_SSH_KEY_PATH=../.local/.keys/deploy_vm_key
# SSH host-key policy for ansible-playbook:
# - accept-new (dev-friendly default)
# - yes (recommended in strict production with managed known_hosts)
# - ask / no
ANSIBLE_STRICT_HOST_KEY_CHECKING=accept-new
# Optional explicit known_hosts file for strict verification:
# ANSIBLE_KNOWN_HOSTS_PATH=/etc/platform/ansible_known_hosts
# Trust On First Use host-key pinning:
# - false (recommended in production)
# - true (default behavior in non-production when value omitted)
# ANSIBLE_HOST_KEY_TRUST_ON_FIRST_USE=false
SERVER_JOB_TIMEOUT_MS=120000
SERVER_PREPARATION_TIMEOUT_MS=900000
# Sécurité serveur SSH:
# false (recommandé): ne modifie pas automatiquement sudoers
# true: autorise la plateforme à ajouter une règle NOPASSWD pour l'utilisateur SSH
SERVER_AUTO_CONFIGURE_SUDOERS=false
# Legacy API transition controls
SERVER_LEGACY_API_ENABLED=true
SERVER_LEGACY_API_SUNSET_DATE=2026-07-31T23:59:59.000Z
# Health-check post-déploiement (après exécution Ansible)
DEPLOY_HEALTHCHECK_ENABLED=true
DEPLOY_HEALTHCHECK_TIMEOUT_MS=5000
DEPLOY_HEALTHCHECK_RETRIES=6
DEPLOY_HEALTHCHECK_RETRY_DELAY_MS=4000
# Note: Les clés privées SSH sont chiffrées en base.
# La plateforme utilise des fichiers temporaires sécurisés (inventory/known_hosts/clé) côté machine de contrôle uniquement.

# Frontend (CORS WebSocket) — URL(s) du frontend autorisé(es) à se connecter au WebSocket
FRONTEND_URL=http://localhost:3000
# FRONTEND_URLS accepte plusieurs URLs séparées par virgule (ex: https://app.example.com,https://app2.example.com)
FRONTEND_URLS=http://localhost:3000

# Timeouts Ansible, SSH et déploiements
DEPLOYMENT_ANSIBLE_TIMEOUT_MS=900000
AUTOMATION_TARGET_TIMEOUT_MS=300000
TERMINAL_SSH_INACTIVITY_TIMEOUT_MS=300000

# Webhook — URL publique de ce backend, utilisée pour configurer les webhooks GitLab automatiquement
WEBHOOK_URL=https://your-backend-domain.example.com
# Mettre à false pour autoriser le build sans configuration webhook automatique
GITLAB_WEBHOOK_AUTO_CONFIGURE=true
# Retry automatique de configuration webhook GitLab (backoff linéaire)
GITLAB_WEBHOOK_MAX_RETRIES=3
GITLAB_WEBHOOK_RETRY_DELAY_MS=1200

# Redis (optionnel — active le rate limiting distribué si défini)
# Sans Redis, le rate limiting reste en mémoire (correct pour instance unique).
# REDIS_URL=redis://localhost:6379
