# App
PORT=3001
# Node environment: development | production | test
# In production, NODE_ENV=production enables stricter logging + cookie security.
NODE_ENV=development
# Winston log level (error|warn|info|http|verbose|debug|silly). Optional, defaults to "info".
LOG_LEVEL=info
# Protects the Swagger UI (docs) in production — set to require this key/password
# to access /api docs once deployed. Optional; without it, Swagger is open.
# SWAGGER_API_KEY=
# Express "trust proxy" setting — required for correct client IPs (rate limiting,
# logging) when running behind a reverse proxy (Traefik/nginx). Number, true/false,
# or an IP. Optional; unset means Express doesn't trust any proxy.
# TRUST_PROXY=1

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=deploy_automation

# Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/deploy_automation

# JWT — générer avec : node -e "require('crypto').randomBytes(48).toString('hex')" | xargs echo "JWT_SECRET="
JWT_SECRET=CHANGE_ME_WITH_A_STRONG_64_CHAR_HEX_SECRET
JWT_EXPIRES_IN=24h
# Back-office (staff) — REQUIS et INDÉPENDANT de JWT_SECRET. Isoler les deux plans
# d'auth : si JWT_SECRET fuit, le staff reste protégé. Générer un secret distinct.
STAFF_JWT_SECRET=CHANGE_ME_WITH_A_DIFFERENT_STRONG_64_CHAR_HEX_SECRET
STAFF_JWT_EXPIRES_IN=12h
STAFF_OTP_SECRET=CHANGE_ME_WITH_A_THIRD_INDEPENDENT_64_CHAR_HEX_SECRET
CUSTOMER_MFA_SECRET=CHANGE_ME_WITH_A_FOURTH_INDEPENDENT_64_CHAR_HEX_SECRET
# ROOT et ADMIN doivent terminer l'enrôlement TOTP avant toute opération.
STAFF_MFA_REQUIRED_ROLES=ROOT,ADMIN
AUTH_COOKIE_NAME=sovrack_token
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_SECURE=false
# Laisser AUTH_COOKIE_DOMAIN absent : cookie host-only sur app.sovrack.com.
# AUTH_COOKIE_MAX_AGE_MS=86400000
STAFF_AUTH_COOKIE_NAME=sovrack_staff_token
STAFF_AUTH_COOKIE_SAME_SITE=strict
STAFF_AUTH_COOKIE_SECURE=false
# Laisser STAFF_AUTH_COOKIE_DOMAIN absent : cookie host-only sur staff.sovrack.com.
# STAFF_AUTH_COOKIE_MAX_AGE_MS=43200000

# GitLab — Configuré depuis l'interface Settings → Git du frontend
# (stocké en base de données, pas dans .env)

# Deployments
# CONFIG_SECRET — minimum 32 caractères. Changer invalide les données chiffrées existantes.
# Générer avec : node -e "require('crypto').randomBytes(32).toString('hex')" | xargs echo "CONFIG_SECRET="
CONFIG_SECRET=CHANGE_ME_WITH_A_STRONG_32_CHAR_HEX_SECRET
# Path to Ansible playbooks. Playbooks are embedded in the backend (since 2026-06,
# the standalone devops/ folder was removed). Optional: defaults to ansible/playbooks
# when unset — only override if you relocate them.
ANSIBLE_PLAYBOOKS_PATH=ansible/playbooks
ANSIBLE_VENV_PATH=.local/.ansible-venv
# Optional legacy variable (not required by Server Setup flow):
# ANSIBLE_SSH_KEY_PATH=../.local/.keys/deploy_vm_key
# SSH host-key policy for ansible-playbook:
# - accept-new (dev-friendly default)
# - yes (recommended in strict production with managed known_hosts)
# - ask / no
ANSIBLE_STRICT_HOST_KEY_CHECKING=accept-new
# Optional explicit known_hosts file for strict verification:
# ANSIBLE_KNOWN_HOSTS_PATH=/etc/platform/ansible_known_hosts
# Trust On First Use host-key pinning:
# - false (recommended in production)
# - true (default behavior in non-production when value omitted)
# ANSIBLE_HOST_KEY_TRUST_ON_FIRST_USE=false
SERVER_JOB_TIMEOUT_MS=120000
SERVER_SETUP_TIMEOUT_MS=900000
# Sécurité serveur SSH:
# false (recommandé): ne modifie pas automatiquement sudoers
# true: autorise la plateforme à ajouter une règle NOPASSWD pour l'utilisateur SSH
SERVER_AUTO_CONFIGURE_SUDOERS=false
# Legacy API transition controls
SERVER_LEGACY_API_ENABLED=true
SERVER_LEGACY_API_SUNSET_DATE=2026-07-31T23:59:59.000Z
# IPv4/CIDR du control-plane autorisé à joindre l'API Docker mTLS (port 2376).
# Requis uniquement lorsque le profil de setup inclut docker_tls.
# DOCKER_TLS_ALLOWED_CIDR=203.0.113.10/32
# Health-check post-déploiement progressif (3 phases : grace → liveness → readiness)
DEPLOY_HEALTHCHECK_ENABLED=true
DEPLOY_HEALTHCHECK_TIMEOUT_MS=5000
# Délai avant le 1er check (laisse l'app démarrer avant de la juger)
DEPLOY_STARTUP_GRACE_MS=15000
# Intervalle entre deux checks (remplace DEPLOY_HEALTHCHECK_RETRY_DELAY_MS)
DEPLOY_HEALTHCHECK_INTERVAL_MS=5000
# Nombre max de tentatives
DEPLOY_HEALTHCHECK_RETRIES=6
# Checks consécutifs réussis requis pour valider (readiness)
DEPLOY_HEALTHCHECK_CONSECUTIVE=2
# Déprécié : conservé comme fallback de DEPLOY_HEALTHCHECK_INTERVAL_MS
DEPLOY_HEALTHCHECK_RETRY_DELAY_MS=4000
# Note: Les clés privées SSH sont chiffrées en base.
# La plateforme utilise des fichiers temporaires sécurisés (inventory/known_hosts/clé) côté machine de contrôle uniquement.

# Frontend (CORS WebSocket) — URL(s) du frontend autorisé(es) à se connecter au WebSocket
FRONTEND_URL=http://localhost:3000
# FRONTEND_URLS accepte plusieurs URLs séparées par virgule (ex: https://app.sovrack.com,https://app2.sovrack.com)
FRONTEND_URLS=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000
CUSTOMER_APP_URL=http://localhost:3000
STAFF_APP_URL=http://localhost:3000

# ── Google OAuth ("Se connecter avec Google") ───────────────────────────────
# Optionnel : laisse vide pour désactiver la connexion Google.
# Crée des identifiants OAuth sur https://console.cloud.google.com (APIs &
# Services → Credentials → OAuth client ID → type "Web application").
# Authorized JavaScript origins = FRONTEND_URL.
# Authorized redirect URIs  = GOOGLE_CALLBACK_URL (doit correspondre EXACTEMENT).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local : http://localhost:3000/backend-api/auth/google/callback
# Prod  : https://sovrack.com/backend-api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:3000/backend-api/auth/google/callback

# Timeouts Ansible, SSH et déploiements
DEPLOYMENT_ANSIBLE_TIMEOUT_MS=900000
AUTOMATION_TARGET_TIMEOUT_MS=300000
# Docker build/pull timeouts (ms). Optional, default to 15 min / 5 min.
DOCKER_BUILD_TIMEOUT_MS=900000
DOCKER_PULL_TIMEOUT_MS=300000
# Override path to the nixpacks binary if it's not on PATH. Optional.
# NIXPACKS_BIN=/usr/local/bin/nixpacks
TERMINAL_SSH_INACTIVITY_TIMEOUT_MS=300000

# Webhook — URL publique de ce backend.
# RECOMMANDÉ : laissez vide et configurez WEBHOOK_BASE_URL via l'UI
#   Réglages → Plateforme → URL publique du backend.
# L'env var ci-dessous est conservée comme fallback transient pour ne pas
# casser les installations existantes ; elle est supplantée par la valeur DB.
# WEBHOOK_URL=https://ton-backend-domaine.com
# Mettre à false pour autoriser le build sans configuration webhook automatique
GITLAB_WEBHOOK_AUTO_CONFIGURE=true
# Retry automatique de configuration webhook GitLab (backoff linéaire)
GITLAB_WEBHOOK_MAX_RETRIES=3
GITLAB_WEBHOOK_RETRY_DELAY_MS=1200

# Redis — REQUIS. BullMQ l'utilise pour la file de déploiements ("deployments")
# et le worker démarre au boot : SANS REDIS_URL, le backend NE DÉMARRE PAS
# (core/queue/queue.provider.ts lève une erreur). Sert aussi de storage au
# rate limiting distribué.
# Démarrer Redis : docker run -p 6379:6379 redis:7-alpine
REDIS_URL=redis://localhost:6379

# SMTP — Les valeurs enregistrées dans Settings → Notifications sont
# prioritaires. Les variables ci-dessous servent de repli, notamment au premier
# démarrage et pour les emails transactionnels (validation, invitation, reset).
# En local, docker-compose.dev.yml les dirige vers Mailpit. En production,
# utiliser un fournisseur transactionnel et garder SMTP_PASS dans le fichier
# de secrets du serveur, jamais dans Git.
SMTP_CONFIG_SOURCE=environment
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASS=
SMTP_FROM=contact@sovrack.com
SMTP_TO=
# Liste séparée par des virgules. En production, limite les destinations que
# ROOT peut enregistrer depuis le back-office (protection contre les relais
# internes accidentels). Exemple : smtp.eu.mailgun.org,smtp.resend.com
SMTP_ALLOWED_HOSTS=

# Slack (notifications — optionnel)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
