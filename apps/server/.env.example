# App
PORT=3001

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=devops_platform

# Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devops_platform

# JWT — générer avec : node -e "require('crypto').randomBytes(48).toString('hex')" | xargs echo "JWT_SECRET="
JWT_SECRET=CHANGE_ME_WITH_A_STRONG_64_CHAR_HEX_SECRET
JWT_EXPIRES_IN=24h
AUTH_COOKIE_NAME=devops_platform_token
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_SECURE=false
# AUTH_COOKIE_DOMAIN=example.com
# AUTH_COOKIE_MAX_AGE_MS=86400000

# GitLab
GITLAB_URL=
GITLAB_TOKEN=

# Deployments
# CONFIG_SECRET — minimum 32 caractères. Changer invalide les données chiffrées existantes.
# Générer avec : node -e "require('crypto').randomBytes(32).toString('hex')" | xargs echo "CONFIG_SECRET="
CONFIG_SECRET=CHANGE_ME_WITH_A_STRONG_32_CHAR_HEX_SECRET
ANSIBLE_PLAYBOOKS_PATH=../devops/ansible/playbooks
ANSIBLE_VENV_PATH=../.local/.ansible-venv
ANSIBLE_SSH_KEY_PATH=../.local/.keys/deploy_vm_key
SERVER_JOB_TIMEOUT_MS=120000
# Health-check post-déploiement (après exécution Ansible)
DEPLOY_HEALTHCHECK_ENABLED=true
DEPLOY_HEALTHCHECK_TIMEOUT_MS=5000
DEPLOY_HEALTHCHECK_RETRIES=6
DEPLOY_HEALTHCHECK_RETRY_DELAY_MS=4000
# Note: Clés SSH et inventaires d'Ansible sont gérés entièrement par la plateforme depuis la base de données.
# Les clés privées des serveurs sont chiffrées et stockées en DB, aucun fichier local n'est utilisé.

# Frontend (CORS WebSocket) — URL du frontend autorisé à se connecter au WebSocket
FRONTEND_URL=http://localhost:3000

# Webhook — URL publique de ce backend, utilisée pour configurer les webhooks GitLab automatiquement
WEBHOOK_URL=https://your-backend-domain.example.com
