{
  "name": "devops-frontend",
  "version": "1.0.0",
  "description": "DevOps Platform Frontend",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "type-check": "next typegen && tsc --noEmit",
    "scaffold:page": "node scripts/scaffold-page.mjs",
    "scaffold:feature": "node scripts/scaffold-feature.mjs",
    "check:architecture": "node scripts/quality-gates.mjs all",
    "check:frontend": "npm run check:architecture && npm run lint -- --max-warnings=0 && npx tsc --noEmit",
    "contract:export-openapi": "cd ../backend && npm run openapi:export",
    "contract:types": "openapi-typescript --default-non-nullable=false src/generated/api-contract.openapi.json -o src/generated/api-contract.ts",
    "contract:generate": "npm run contract:export-openapi && npm run contract:types"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-query": "^5.99.2",
    "@tanstack/react-query-devtools": "^5.99.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "axios": "^1.14.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.7.0",
    "next": "^15.1.0",
    "postcss": "^8.4.49",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^3.4.14",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "dompurify": "^3.4.1"
  }
}
