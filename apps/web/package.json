{
  "name": "deploy-automation-frontend",
  "version": "1.0.0",
  "description": "Deploy Automation Frontend",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "type-check": "next typegen && tsc --noEmit",
    "scaffold:page": "node scripts/scaffold-page.mjs",
    "scaffold:feature": "node scripts/scaffold-feature.mjs",
    "check:architecture": "node scripts/quality-gates.mjs all",
    "check:frontend": "npm run check:architecture && npm run lint -- --max-warnings=0 && npx tsc --noEmit",
    "contract:export-openapi": "cd ../backend && npm run openapi:export",
    "contract:types": "openapi-typescript --default-non-nullable=false src/generated/api-contract.openapi.json -o src/generated/api-contract.ts",
    "contract:generate": "npm run contract:export-openapi && npm run contract:types",
    "contract:generate:help": "echo 'contract:generate requires the backend repo at ../backend. In CI use contract:types only (reads committed openapi.json).'"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.99.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "axios": "^1.14.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.7.0",
    "next": "^15.5.22",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.9.0",
    "socket.io-client": "^4.8.3",
    "zod": "^4.3.6",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tanstack/react-query-devtools": "^5.99.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.9",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.22",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.7.3",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "dompurify": "^3.4.12",
    "js-yaml": "^4.2.2",
    "postcss": "^8.5.25",
    "sharp": "^0.35.3"
  }
}
