# =============================================================================
# Sovrack — .env de PRODUCTION (template)
# -----------------------------------------------------------------------------
# Copie ce fichier en `.env` sur le VPS, puis RENSEIGNE les secrets réels.
# NE JAMAIS committer les valeurs réelles. Ce fichier est le modèle.
# Génère les secrets avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# NOTE : `$` dans les valeurs doit être échappé en `$$` car Compose interprète
# les variables dans ce niveau d'indentation.
# =============================================================================

# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME=Sovrack
APP_VERSION=1.0.0
LOG_LEVEL=info

# URL publiques (domaines). REMPLACER sovrack.com par ton vrai domaine.
DOMAIN=sovrack.com
APP_DOMAIN=app.sovrack.com
STAFF_DOMAIN=staff.sovrack.com
STAGING_DOMAIN=staging.sovrack.com
PUBLIC_SITE_URL=https://sovrack.com
CUSTOMER_APP_URL=https://app.sovrack.com
STAFF_APP_URL=https://staff.sovrack.com
FRONTEND_PUBLIC_URL=https://app.sovrack.com
HOST_PLANE_ENFORCEMENT=true
# Exact hostnames/IPs for explicitly approved private self-hosted Git servers.
# Keep empty when all Git providers are public.
OUTBOUND_PRIVATE_HOST_ALLOWLIST=
FRONTEND_WS_PUBLIC_URL=wss://app.sovrack.com
CERTBOT_EMAIL=contact@sovrack.com
CERTBOT_IMAGE=certbot/certbot@sha256:34ee91d2f43008eb78a007d22f23ed4b2eaa9a454cb27ca2c042b49527a695b4
CERTBOT_DOMAINS=sovrack.com,www.sovrack.com,app.sovrack.com,staff.sovrack.com,staging.sovrack.com
# Uniquement pour une qualification isolée avec certificat autosigné.
# Cette valeur doit impérativement rester false en production.
ALLOW_SELF_SIGNED_TLS=false

# ── Database (Postgres) ──────────────────────────────────────────────────────
POSTGRES_USER=da_admin
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_STRONG
POSTGRES_DB=sovrack
# Obligatoire : tag de commit ou digest immuable. `latest` est refusé par
# deploy.sh afin qu'une release et son rollback soient reproductibles.
SERVER_IMAGE=ghcr.io/sovrack/server:REPLACE_WITH_FULL_COMMIT_SHA
WEB_IMAGE=ghcr.io/sovrack/web:REPLACE_WITH_FULL_COMMIT_SHA
BACKEND_IMAGE=ghcr.io/sovrack/server:REPLACE_WITH_FULL_COMMIT_SHA
FRONTEND_IMAGE=ghcr.io/sovrack/web:REPLACE_WITH_FULL_COMMIT_SHA

# Images d'infrastructure figées. La pipeline les inscrit aussi dans le
# manifeste de release afin que promotion et rollback utilisent les mêmes bits.
NGINX_IMAGE=nginx@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10
POSTGRES_IMAGE=postgres@sha256:cf78e76683b9ca8c5733cbbdce6c9262b45b6767934dd0a95e671f9a0fc20685
REDIS_IMAGE=redis@sha256:ff02b58f971e7d7d156a1267e283fcbbeee91773b6aa36c49dac28ecfe28eadf

# ── Cloudflare R2 / AWS S3 Automated Backups ─────────────────────────────────
S3_BACKUP_ENABLED=true
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=sovrack-backups
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Capacité et limites ──────────────────────────────────────────────────────
# Le preflight refuse un petit hôte avant d'ouvrir la maintenance. Ne positionner
# ALLOW_UNDERSIZED_HOST=true qu'après un test de charge documenté.
MIN_HOST_MEMORY_MB=3584
MIN_HOST_FREE_DISK_MB=8192
ALLOW_UNDERSIZED_HOST=false
BACKEND_MEMORY_LIMIT=896M
WORKER_MEMORY_LIMIT=1G
POSTGRES_MEMORY_LIMIT=768M
FRONTEND_MEMORY_LIMIT=384M
NGINX_MEMORY_LIMIT=96M

# Rotation bornée des stdout/stderr Docker.
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=5

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_redis_strong

# ── Secrets JWT (≥32 caractères chacun) ──────────────────────────────────────
JWT_SECRET=change_me_jwt_secret_at_least_32_chars
JWT_EXPIRES_IN=24h
STAFF_JWT_SECRET=change_me_staff_jwt_secret_at_least_32_chars
STAFF_JWT_EXPIRES_IN=12h
STAFF_OTP_SECRET=change_me_staff_otp_secret_at_least_32_chars
CUSTOMER_MFA_SECRET=change_me_customer_mfa_secret_at_least_32_chars
STAFF_MFA_REQUIRED_ROLES=ROOT,ADMIN

# ── Chiffrement des configs serveur ──────────────────────────────────────────
CONFIG_SECRET=change_me_config_secret_at_least_32_chars

# ── CORS ─────────────────────────────────────────────────────────────────────
# (Domaine déjà défini via FRONTEND_PUBLIC_URL ; garde pour info)
TRUST_PROXY=1

# ── Reverse proxy trust ──────────────────────────────────────────────────────
ANSIBLE_STRICT_HOST_KEY_CHECKING=accept-new

# ── Email transactionnel (OVH Zimbra / MX Plan) ──────────────────────────────
# Deux modes exclusifs :
#   1. environment : renseigner ici un snapshot SMTP complet ;
#   2. database : laisser SMTP désactivé ici puis configurer depuis le staff.
# Dans les deux cas, SMTP_ALLOWED_HOSTS doit contenir uniquement les fournisseurs
# approuvés avant d'autoriser l'édition depuis le back-office.
SMTP_CONFIG_SOURCE=environment
SMTP_ENABLED=true
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_SECURITY=tls
SMTP_USER=contact@sovrack.com
SMTP_PASS=
SMTP_FROM=contact@sovrack.com
SMTP_TO=contact@sovrack.com
SMTP_ALLOWED_HOSTS=ssl0.ovh.net

# Aucun mot de passe ROOT initial n'est stocké. Après la première promotion,
# `make bootstrap-staff EMAIL=...` envoie un code à usage unique via SMTP ; le
# destinataire choisit ensuite son mot de passe sur /staff/activate.

# ── Cookies ──────────────────────────────────────────────────────────────────
AUTH_COOKIE_SAME_SITE=lax
STAFF_AUTH_COOKIE_SAME_SITE=strict

# ── Google OAuth ("Se connecter avec Google") ────────────────────────────────
# Laisser vide pour désactiver. Identifiants créés sur https://console.cloud.google.com
# (APIs & Services → Credentials → OAuth client ID → "Web application").
# Google Console → Authorized redirect URIs doit contenir GOOGLE_CALLBACK_URL exactement.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://app.sovrack.com/backend-api/auth/google/callback

# ── Backups chiffrés hors VPS (Restic) ──────────────────────────────────────
# Laisser désactivé tant qu'un dépôt distant n'a pas été initialisé et testé.
BACKUP_RETENTION=7
BACKUP_OFFSITE_ENABLED=false
RESTIC_IMAGE=
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-3
