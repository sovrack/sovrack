# =============================================================================
# Sovrack — nginx template (reverse proxy + TLS)
# Ce fichier est utilisé comme template par l'image nginx (envsubst).
# ${DOMAIN} remplacé au run via le .env du conteneur (le service nginx
# n'a pas de variable DOMAIN actuellement → on utilise les valeurs littérales
# issues du .env injecté dans nginx service).
#
# NB : le compose injecte les variables dans nginx via environment (voir le
# service nginx). Voici la conf route qui délègue au frontend/backend sur le
# réseau Docker via les noms de service.
# =============================================================================

# ── Frontend : https://sovrack.tech → Next.js ────────────────────────────────
server {
    listen 80;
    server_name ${DOMAIN};
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    include /etc/nginx/conf.d/security-headers.conf;

    # Proxy le backend (API) sous /backend-api pour que le frontend en soit proxy
    location /backend-api/ {
        proxy_pass http://backend:3001/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        # WebSocket (logs temps réel)
        proxy_read_timeout 3600s;
    }

    # Route le frontend
    location / {
        proxy_pass http://frontend:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}