# =============================================================================

# Les zones sont partagées par tous les workers Nginx. Une clé vide désactive
# la zone : seules les routes d'authentification sensibles utilisent la limite
# stricte, tandis que toute l'API bénéficie d'une protection anti-rafale.
map $uri $sovrack_auth_limit_key {
    default "";
    ~^/backend-api/(auth/(login|register|verify-email|resend-code|forgot-password|reset-password)|staff/login)$ $binary_remote_addr;
}
limit_req_zone $binary_remote_addr zone=sovrack_api:10m rate=20r/s;
limit_req_zone $sovrack_auth_limit_key zone=sovrack_auth:10m rate=5r/m;
limit_conn_zone $binary_remote_addr zone=sovrack_connections:10m;
# Sovrack — nginx template (reverse proxy + TLS)
# Ce fichier est utilisé comme template par l'image nginx (envsubst).
# ${DOMAIN} remplacé au run via le .env du conteneur (le service nginx
# n'a pas de variable DOMAIN actuellement → on utilise les valeurs littérales
# issues du .env injecté dans nginx service).
#
# NB : le compose injecte les variables dans nginx via environment (voir le
# service nginx). Voici la conf route qui délègue au frontend/backend sur le
# réseau Docker via les noms de service.
# =============================================================================

# ── Frontend : https://sovrack.tech → Next.js ────────────────────────────────
server {
    listen 80;
    server_name ${DOMAIN} www.${DOMAIN};
    server_tokens off;
    client_max_body_size 15m;
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://${DOMAIN}$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN} www.${DOMAIN};
    server_tokens off;
    client_max_body_size 15m;

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    include /etc/nginx/conf.d/security-headers.conf;

    # Nginx est l'autorité unique pour ces en-têtes. Les variantes éventuellement
    # ajoutées par Next.js ou l'API sont masquées afin d'éviter les doublons.
    proxy_hide_header X-Powered-By;
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Referrer-Policy;
    proxy_hide_header Permissions-Policy;
    proxy_hide_header Strict-Transport-Security;

    limit_req_status 429;
    limit_conn_status 429;
    limit_conn sovrack_connections 50;

    # Docker DNS. Les URLs sous forme de variables sont résolues au moment de
    # la requête : Nginx peut ainsi démarrer seul et servir la maintenance même
    # lorsque backend/frontend sont volontairement arrêtés.
    resolver 127.0.0.11 valid=30s ipv6=off;
    set $backend_upstream http://backend:3001;
    set $frontend_upstream http://frontend:3000;

    # Le fichier est activé uniquement pendant une promotion/restauration. Le
    # test est fait à chaque requête : aucune reconstruction d'image ni reload
    # Nginx n'est nécessaire pour ouvrir/fermer la maintenance.
    if (-f /var/run/sovrack-maintenance/enabled) {
        return 503 '{"status":"maintenance"}';
    }

    # Une seule origine canonique pour les cookies, OAuth et liens générés.
    if ($host != ${DOMAIN}) {
        return 301 https://${DOMAIN}$request_uri;
    }

    # Les sondes restent hors quota pour ne jamais masquer l'état réel du service.
    location ~ ^/backend-api/health(?:/live|/ready)?/?$ {
        rewrite ^/backend-api/(.*)$ /$1 break;
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Proxy le backend (API) sous /backend-api pour que le frontend en soit proxy
    location /backend-api/ {
        limit_req zone=sovrack_api burst=40 nodelay;
        limit_req zone=sovrack_auth burst=5 nodelay;
        rewrite ^/backend-api/(.*)$ /$1 break;
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        # WebSocket (logs temps réel)
        proxy_read_timeout 3600s;
    }

    # Route le frontend
    location / {
        proxy_pass $frontend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
