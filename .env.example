# ==============================================================================
# Sovrack — Root Environment Configuration (.env.example)
# https://sovrack.tech — Modern Multi-Server Deployment Platform
# ==============================================================================
# Copy this file to `.env` (or configure apps/server/.env and apps/web/.env.local)
# Generate secrets using: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ==============================================================================

# ── 1. CORE APPLICATION ───────────────────────────────────────────────────────
APP_NAME=Sovrack
APP_VERSION=3.1.0
NODE_ENV=production
LOG_LEVEL=info

# Domains & URLs
DOMAIN=sovrack.tech
PUBLIC_SITE_URL=https://sovrack.tech
FRONTEND_PUBLIC_URL=https://app.sovrack.tech
NEXT_PUBLIC_API_URL=https://api.sovrack.tech

# ── 2. DATABASE (PostgreSQL) ──────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_WITH_A_STRONG_PASSWORD
DB_NAME=sovrack
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public

# ── 3. CACHE & QUEUES (Redis) ─────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# ── 4. SECURITY & AUTHENTICATION SECRETS ───────────────────────────────────────
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_WITH_A_STRONG_64_CHAR_HEX_SECRET
JWT_EXPIRES_IN=24h

# Staff Back-office (isolated authentication plane)
STAFF_JWT_SECRET=CHANGE_ME_WITH_A_DIFFERENT_STRONG_64_CHAR_HEX_SECRET
STAFF_JWT_EXPIRES_IN=12h
STAFF_OTP_SECRET=CHANGE_ME_WITH_A_THIRD_INDEPENDENT_64_CHAR_HEX_SECRET
CUSTOMER_MFA_SECRET=CHANGE_ME_WITH_A_FOURTH_INDEPENDENT_64_CHAR_HEX_SECRET

# Symmetric key for encrypting stored SSH keys and DB credentials (32-byte hex)
DATA_ENCRYPTION_KEY=CHANGE_ME_WITH_A_32_BYTE_HEX_ENCRYPTION_KEY

# ── 5. PRODUCT CAPABILITIES & MODE (Open-Core / SaaS) ─────────────────────────
# In Self-Hosted Community edition: leave BILLING_ENABLED=false
# In Cloud SaaS edition (sovrack.tech): set BILLING_ENABLED=true
BILLING_ENABLED=false
GOOGLE_AUTH_ENABLED=true

# ── 6. OAUTH PROVIDERS (Optional in Self-Hosted, Required for SaaS) ────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.sovrack.tech/auth/google/callback

# ── 7. BILLING GATEWAYS (Stripe & Konnect) ────────────────────────────────────
# Stripe (Global Credit Cards)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# Konnect (North Africa / MENA gateway)
KONNECT_API_KEY=
KONNECT_WALLET_ID=
KONNECT_WEBHOOK_SECRET=

# ── 8. NOTIFICATIONS & EMAIL (SMTP) ───────────────────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_FROM="Sovrack <noreply@sovrack.tech>"

# ── 9. ENTERPRISE LICENSE (Optional) ──────────────────────────────────────────
# Leave empty for Community Edition. Contact sales@sovrack.tech for Enterprise.
SOVRACK_LICENSE_KEY=
LICENSE_VERIFICATION_SECRET=sovrack-enterprise-offline-signing-secret-2026
