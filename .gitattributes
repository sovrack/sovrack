# Auto-detect text files and perform LF normalization
* text=auto

# Shell scripts and container configurations must strictly use LF
*.sh text eol=lf
*.bash text eol=lf
*.template text eol=lf
*.conf text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf
.env* text eol=lf
